{
  "name": "eclipse-client-launcher",
  "productName": "Eclipse Client",
  "version": "1.0.0-beta",
  "description": "Eclipse Client — an optimized Minecraft launcher",
  "main": "main.js",
  "author": "ojnyxus",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ojnyxus.eclipseclient",
    "productName": "Eclipse Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Eclipse-Client-Setup.exe"
    }
  }
}
